# Python 가상환경
.venv/
venv/
env/

# Python·테스트·정적 검사 캐시
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# 패키지 빌드 산출물
build/
dist/
*.egg-info/

# 환경변수·인증서·로컬 인증정보
.env
.env.*
!.env.example
.secrets/
secrets/
credentials/
.aws/
*.pem
*.key

# 원자료·중간자료·특징표: 폴더 표시 파일만 허용
/data/**/*
!/data/**/
!/data/**/.gitkeep

# 학습 모형·입력 변환기: src/models/의 Python 코드는 포함
/models/**/*
!/models/**/
!/models/**/.gitkeep

# 예측·평가·실행 기록: 폴더 표시 파일만 허용
/outputs/**/*
!/outputs/**/
!/outputs/**/.gitkeep

# 실행 이력·데이터 관측은 폴더 표시 파일까지 모두 제외
/outputs/run_id/
# model_test 결과는 팀 공유(2026-11-15): outputs/model_results/<작성자>/<결과 폴더>/result.zip만 커밋한다(실행 1회 = 파일 1개).
# result.zip = 표·곡선(예측값 제외, 선형 예측값 356MB > GitHub 100MB). 풀린 파일과 예측값은 각자 PC에만.
!/outputs/model_results/**/result.zip
# 팀원 결과 표(2026-11-15): 작성자 폴더 바로 아래 csv는 올린다(요약 표는 수 KB). 예측값 parquet는 제외 그대로.
!/outputs/model_results/*/*.csv
# jiun 결과는 당분간 커밋하지 않는다(2026-11-17, 결과가 너무 많아짐). 팀원 폴더 규칙은 그대로. 이미 커밋된 파일은 그대로 추적됨.
/outputs/model_results/jiun/
# 결과 비교 노트북은 관리자 개인용(공유 안 함, 2026-11-15)
/notebook/model_test_summary.ipynb
/outputs/데이터관측/

# 별도 경로에 저장한 모형·배열 산출물
*.joblib
*.pkl
*.pickle
*.pt
*.pth
*.onnx
*.npy
*.npz

# 개인 IDE·에이전트 설정
.vscode/
.idea/
*.code-workspace
.codex/
.agents/
.claude/

# 개인 작업 지침·연구 기록
/AGENTS.md
/CLAUDE.md
/docs/

# 운영체제 임시 파일
.DS_Store
Thumbs.db
desktop.ini
~$*

# 팀원 H2 코드(src/h2/)가 쓰는 결과 폴더(공유 안 함, 2026-11-15)
/results/
